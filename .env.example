# Copy to .env and fill in. All are optional: without a key the game falls back
# to scripted banter lines and the browser's built-in voice.

# Cartesia — streaming STT (Ink 2) + TTS (Sonic 3.5).
VITE_CARTESIA_API_KEY=

# OpenAI — default banter backend.
VITE_OPENAI_API_KEY=

# Sail Research — alternative banter backend (Kimi K2.6, GLM-5.2, etc).
# Pick the model from the dock dropdown at runtime.
VITE_SAIL_API_KEY=

# Optional: which model to start on. Ids come from LLM_MODEL_OPTIONS in
# src/api/llmProviders.ts — e.g. gpt-4.1-mini, sail-kimi-k2.6, sail-glm-5.2.
# The dock dropdown overrides this and persists your choice.
VITE_LLM_MODEL=

# Optional: Sail service tier. Only `asap` is viable for live conversation —
# `priority` averages ~1 minute per turn and `standard` ~5 minutes.
# One of: asap | priority | standard | flex
VITE_SAIL_COMPLETION_WINDOW=asap
